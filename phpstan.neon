includes:
    - ./phpstan-baseline.neon
    - ../../vendor/larastan/larastan/extension.neon
    - ../../vendor/nesbot/carbon/extension.neon
    - ../../vendor/pestphp/pest/extension.neon
    #- ./../../vendor/larastan/larastan/extension.neon
    #- ./../../vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    #- ./vendor/symplify/phpstan-rules/config/code-complexity-rules.neon
    #- ./vendor/symplify/phpstan-rules/config/collector-rules.neon
    #- ./vendor/symplify/phpstan-rules/config/naming-rules.neon
    #- ./vendor/symplify/phpstan-rules/config/regex-rules.neon
    #- ./vendor/symplify/phpstan-rules/config/static-rules.neon

parameters:

    level: max

    paths:
        - ./app
        - ./config
        - ./database
        - ./lang
        - ./resources
        - ./routes
        - ./tests
    
          

    ignoreErrors:
    #    - '#Unsafe usage of new static#'
        - '#PHPDoc tag @mixin contains unknown class #'
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#'
        - identifier: theCodingMachineSafe.function

    excludePaths:
        - ./vendor/*
        - ./build/*
        - ./docs/*
        - ./*/build/*
        - ./*/vendor/*
        - ./*/docs/*
        - ./*/_ide_helper.php

    bootstrapFiles:
        - ./phpstan_constants.php
        - ../../vendor/autoload.php

    scanFiles:
    #    - ./helpers/Helper.php
    #    - ./vendor/amenadiel/jpgraph/src/config.inc.php
    #    - ../../vendor/autoload.php
    
    scanDirectories:
        - ../../vendor/

    editorUrl: 'vscode://file/%%file%%:%%line%%'

    tmpDir: ./build/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

